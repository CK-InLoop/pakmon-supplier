# MongoDB
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database

# Auth.js / NextAuth
AUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_SECRET=use-the-same-value-as-auth-secret
NEXTAUTH_URL=https://pakmon-supplier.vercel.app

# Email delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=verified-sender@example.com

# One-time default administrator bootstrap
DEFAULT_ADMIN_EMAIL=your-admin@example.com
DEFAULT_ADMIN_PASSWORD=use-a-strong-password
DEFAULT_ADMIN_BOOTSTRAP_VERSION=1
